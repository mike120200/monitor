# 所有运行环境变量都写在本文件对应的 .env；不提交真实凭证。
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
HTTP_PROXY_URL=
HTTP_TIMEOUT_SECONDS=25
HTTP_RETRIES=2
TELEGRAM_MAX_ATTEMPTS=8
BINANCE_BASE_URL=https://api.binance.com
CODEX_BIN=/opt/homebrew/bin/codex
# 空值表示使用现有Codex配置的默认模型
CODEX_MODEL=gpt-6-sol
CODEX_TIMEOUT_SECONDS=600
POLL_SECONDS=300
ANALYSIS_INTERVAL_SECONDS=21600
COOLDOWN_SECONDS=3600
MAX_SNAPSHOT_AGE_SECONDS=900
MAX_SOURCE_AGE_SECONDS=180
KEEP_AWAKE=true
DROP_15M_PCT=2
DROP_1H_PCT=3
DROP_24H_PCT=6
SEVERE_DROP_1H_PCT=5
SEVERE_DROP_24H_PCT=10
RISE_24H_PCT=6
RISE_7D_PCT=15
DRAWDOWN_LEVELS=15,20,30,40
VOLUME_DROP_PCT=2
VOLUME_RATIO=2
RECOVERY_RSI=30
HOT_RSI=75
HOT_MA20_DISTANCE_PCT=15

# 只读余额查询：CLI 使用已有认证；不把密钥传给 Codex
BINANCE_CLI_BIN=/Users/binbin/.cargo/bin/binance-cli
# 留空使用 CLI 当前配置账户；指定名称则固定该 profile
BINANCE_CLI_PROFILE=
CODEX_REASONING_EFFORT=medium

# 买入资金中的手续费预留比例，并非账户实际费率
USDC_FEE_RESERVE_PCT=0.2
